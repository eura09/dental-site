# Lokale Entwicklung: kopieren nach .env und anpassen.
DATABASE_URL=file:./data/payload.db
# Lange Zufallszeichenfolge, z. B. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Öffentliche URL der Website (ohne Schrägstrich am Ende)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Ordner für hochgeladene Bilder (in Produktion ausserhalb des Deploy-Ordners)
MEDIA_DIR=./media
